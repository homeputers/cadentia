{
  "name": "@cadentia/admin-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cadentia administrative web console shell.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:metadata && tsc -b && vite build",
    "build:metadata": "node scripts/write-build-metadata.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-admin-bundle.mjs",
    "generate:client": "node scripts/generate-client.mjs",
    "generate:client:check": "node scripts/generate-client.mjs --check"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "vite": "5.4.21",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "jsdom": "25.0.1"
  }
}
