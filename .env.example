CADENTIA_DB_URL=jdbc:postgresql://localhost:5432/cadentia
CADENTIA_DB_USERNAME=cadentia
CADENTIA_DB_PASSWORD=cadentia
PORT=8080

# First-party authentication service (use the same internal key for both services).
CADENTIA_AUTH_PROVIDER=first-party
CADENTIA_AUTH_SERVICE_BASE_URL=http://localhost:8081
CADENTIA_AUTH_ISSUER_URL=http://localhost:8081
CADENTIA_AUTH_JWK_SET_URI=http://localhost:8081/oauth2/jwks
CADENTIA_AUTH_INTERNAL_API_KEY=replace-with-a-local-secret
CADENTIA_ADMIN_WEB_BASE_URL=http://localhost:5173
CADENTIA_AUTH_BOOTSTRAP_EMAIL=
CADENTIA_AUTH_BOOTSTRAP_DISPLAY_NAME=
CADENTIA_AUTH_BOOTSTRAP_PASSWORD=

# Live local Telegram webhook testing.
# Keep real values in .env or .env.local; both are git-ignored.
CADENTIA_TELEGRAM_BOT_TOKEN=
CADENTIA_TELEGRAM_WEBHOOK_SECRET=
CADENTIA_TELEGRAM_BOT_ID=local
CADENTIA_TELEGRAM_PUBLIC_BASE_URL=
CADENTIA_TELEGRAM_WEBHOOK_URL=
