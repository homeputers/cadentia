root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# Backend: Google Java Style adapted to four spaces.
[*.java]
indent_size = 4
continuation_indent_size = 8
max_line_length = 100
ij_java_class_count_to_use_import_on_demand = 999
ij_java_names_count_to_use_import_on_demand = 999

# TypeScript: Google TypeScript Style uses two-space indentation.
[*.{ts,tsx,mts,cts}]
indent_size = 2
max_line_length = 100
quote_type = double

[*.{json,yml,yaml,md,xml}]
indent_size = 2
