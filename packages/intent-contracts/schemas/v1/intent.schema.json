{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cadentia.local/schemas/intent/v1/intent.schema.json",
  "title": "Cadentia LLM Intent Contract v1",
  "description": "Versioned ADR-012 intent extraction schema. Defaults are annotations for backend default application; the schema rejects unsupported fields and never permits song selections or catalog decisions.",
  "oneOf": [
    { "$ref": "#/definitions/generateSetlistIntent" },
    { "$ref": "#/definitions/clarifyRequestIntent" },
    { "$ref": "#/definitions/unsupportedRequestIntent" }
  ],
  "definitions": {
    "boundedString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 250
    },
    "slotString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "scriptureReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "serviceMoment": {
      "type": ["string", "null"],
      "enum": ["opening", "communion", "response", "altar_call", "sending", "other", null],
      "default": null
    },
    "energyArc": {
      "type": ["string", "null"],
      "enum": ["steady", "rising", "falling", "low_to_high", "high_to_low", null],
      "default": null
    },
    "language": {
      "type": ["string", "null"],
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "default": null
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "default": { "praise": 10, "worship": 5 },
      "properties": {
        "praise": { "type": "integer", "minimum": 0, "maximum": 25, "default": 10 },
        "worship": { "type": "integer", "minimum": 0, "maximum": 25, "default": 5 }
      }
    },
    "keyPolicy": {
      "type": "object",
      "additionalProperties": false,
      "default": {
        "preferSameKey": true,
        "allowRelativeMajorMinor": true,
        "maxKeyCenters": 2
      },
      "properties": {
        "preferSameKey": { "type": "boolean", "default": true },
        "allowRelativeMajorMinor": { "type": "boolean", "default": true },
        "maxKeyCenters": { "type": "integer", "minimum": 1, "maximum": 12, "default": 2 }
      }
    },
    "tempoPolicy": {
      "type": "object",
      "additionalProperties": false,
      "default": { "maxJumpBpm": 12 },
      "properties": {
        "maxJumpBpm": { "type": "integer", "minimum": 1, "maximum": 60, "default": 12 }
      }
    },
    "generateSetlistSlots": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "verseText": { "type": "string", "maxLength": 5000, "default": "" },
        "scriptureReferences": {
          "type": "array",
          "maxItems": 20,
          "default": [],
          "items": { "$ref": "#/definitions/scriptureReference" }
        },
        "themeHints": {
          "type": "array",
          "maxItems": 20,
          "default": [],
          "items": { "$ref": "#/definitions/slotString" }
        },
        "counts": { "$ref": "#/definitions/counts" },
        "keyPolicy": { "$ref": "#/definitions/keyPolicy" },
        "tempoPolicy": { "$ref": "#/definitions/tempoPolicy" },
        "language": { "$ref": "#/definitions/language" },
        "energyArc": { "$ref": "#/definitions/energyArc" },
        "excludedSongs": {
          "type": "array",
          "maxItems": 25,
          "default": [],
          "items": { "$ref": "#/definitions/slotString" }
        },
        "serviceMoment": { "$ref": "#/definitions/serviceMoment" }
      }
    },
    "generateSetlistIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "slots"],
      "properties": {
        "intent": { "const": "GENERATE_SETLIST" },
        "slots": { "$ref": "#/definitions/generateSetlistSlots" }
      }
    },
    "clarifyRequestIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "reasonCode", "clarificationQuestion"],
      "properties": {
        "intent": { "const": "CLARIFY_REQUEST" },
        "reasonCode": {
          "type": "string",
          "enum": ["MISSING_REQUIRED_INFORMATION", "AMBIGUOUS_REQUEST", "INSUFFICIENT_CONTEXT"]
        },
        "clarificationQuestion": { "type": "string", "minLength": 1, "maxLength": 500 },
        "missingSlots": {
          "type": "array",
          "maxItems": 20,
          "default": [],
          "items": {
            "type": "string",
            "enum": [
              "verseText",
              "scriptureReferences",
              "themeHints",
              "counts",
              "keyPolicy",
              "tempoPolicy",
              "language",
              "energyArc",
              "excludedSongs",
              "serviceMoment"
            ]
          }
        }
      }
    },
    "unsupportedRequestIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "reasonCode", "safeMessage"],
      "properties": {
        "intent": { "const": "UNSUPPORTED_REQUEST" },
        "reasonCode": {
          "type": "string",
          "enum": ["OUT_OF_SCOPE", "UNSUPPORTED_ACTION", "UNSUPPORTED_INTENT"]
        },
        "safeMessage": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}
